# 统一用 LF 换行，避免 Windows / macOS 协作时整文件 diff。
# 配合仓库级 core.autocrlf=false（见 README「开发」一节）。
* text=auto eol=lf

*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# 锁文件不参与 diff，也不计入语言统计
package-lock.json -diff linguist-generated=true
